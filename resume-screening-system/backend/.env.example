# Copy this file to `.env` and fill in real values. Never commit `.env` itself.

# Database
DATABASE_URL=sqlite:///./resume_screening.db
# For MySQL later: mysql+pymysql://user:password@localhost:3306/resume_screening

# Auth (Part 3 me use hoga)
SECRET_KEY=change-this-to-a-random-secret-key-later
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Upload
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=../data/uploads

# App
APP_NAME=AI Resume Screening System
DEBUG=True
